{
  "json.schemas": [{
    "fileMatch": ["/taon.jsonc"],
    "url": "./taon-config-standalone.schema.json"
  }],

  "workbench.colorCustomizations": {
    "activityBar.background": "#54be23",
    "statusBar.background": "#a86834",
    "statusBar.debuggingBackground": "#15d8ff"
  },

  "files.watcherExclude": {
    "local_release/**": true,
    "tmp-*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-nocutsrc/**": true
  },

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "editor.rulers": [80, 120],
  "eslint.migration.2_x": "off",
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlineSuggest.enabled": true,
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.endOfLine": "auto",
  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,

  "files.associations": {
    "tsconfig.json": "json"
  },

  "search.followSymlinks": false,
  "search.useIgnoreFiles": false,
  "search.include": ["**/src/**"],

  "search.exclude": {
    "bin": true,
    "local_release": true,
    "node_modules": true,
    ".build": true,
    ".vscode": true,
    "browser": true,
    "dist": true,
    "dist-*": true,
    "package-lock.json": true,
    "tmp-*": true,
    "src/lib/env/**/*.*": true,
    "*.rest": true,
    "**/bin": true,
    "**/local_release": true,
    "**/node_modules": true,
    "**/.build": true,
    "**/.vscode": true,
    "**/browser": true,
    "**/dist": true,
    "**/dist-*": true,
    "**/package-lock.json": true,
    "**/tmp-*": true,
    "**/src/lib/env/**/*.*": true,
    "**/*.rest": true,
    "projects": true,
    ".firedev": true,
    ".taon": true,
    ".tnp": true,
    "src/app.auto-gen-docs.md": true,
    "src/app.auto-gen-ver.js": true
  },

  "window.title": "taon-dev/i18n () [ ${activeEditorShort}]",

  "files.exclude": {}
}